# Bu dosyayı kopyalayıp adını .env yapın ve değerleri doldurun.
# .env GitHub'a YÜKLENMEZ (.gitignore'da). Bu örnek dosyada gerçek parola/anahtar olmaz.

# --- Veritabanı ---
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=LogAnomali
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED=yes

# --- Flask ---
SECRET_KEY=buraya_rastgele_uzun_bir_metin
# Geliştirirken 1 yapabilirsiniz. Canlı link açarken MUTLAKA 0 olmalı.
FLASK_DEBUG=0

# --- E-posta bildirimi (Hafta 9, isteğe bağlı) ---
# Boş bırakılırsa e-posta gönderilmez, uygulama yine çalışır.
SMTP_HOST=
SMTP_PORT=587
SMTP_KULLANICI=
SMTP_PAROLA=
BILDIRIM_EPOSTA=

# --- Yapay zekâ özeti (Hafta 10, isteğe bağlı) ---
# Boş bırakılırsa özetler kural tabanlı şablonla yazılır.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
